---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class={`excalidraw-container ${className}`}>
  <div class="diagram-toolbar">
    <div class="toolbar-left">
      <span class="toolbar-icon">✎</span>
      <span class="toolbar-title">SAGA INVARIANT MENTAL MODEL</span>
    </div>
    <div class="toolbar-tags">
      <span class="tool-tag">MIT 6.042J Sec 3.3</span>
      <span class="tool-tag tag-gold">Conservation Law</span>
    </div>
  </div>

  <div class="diagram-canvas-wrap">
    <svg 
      viewBox="0 0 960 540" 
      class="excalidraw-svg" 
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="Excalidraw mental model diagram of distributed saga balance conservation"
    >
      <defs>
        <!-- Gradients -->
        <linearGradient id="cardGradDark" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#0f172a" stop-opacity="0.95" />
          <stop offset="100%" stop-color="#090d16" stop-opacity="0.95" />
        </linearGradient>
        <linearGradient id="escrowGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#1e293b" stop-opacity="0.95" />
          <stop offset="100%" stop-color="#0f172a" stop-opacity="0.95" />
        </linearGradient>

        <!-- Arrow Markers -->
        <marker id="arrowGreen" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 10 5 L 0 9 z" fill="#10b981" />
        </marker>
        <marker id="arrowRed" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 10 5 L 0 9 z" fill="#ef4444" />
        </marker>
        <marker id="arrowAmber" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 10 5 L 0 9 z" fill="#f59e0b" />
        </marker>
        <marker id="arrowBlue" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 10 5 L 0 9 z" fill="#60a5fa" />
        </marker>

        <!-- Blueprint Sketch Filter (hand-drawn subtle wobble) -->
        <filter id="handDrawn" x="-5%" y="-5%" width="110%" height="110%">
          <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="1" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.4" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>

      <!-- Outer Boundary: The Conserved Universe -->
      <rect 
        x="20" y="20" width="920" height="500" rx="20" 
        fill="url(#cardGradDark)" 
        stroke="#3b82f6" stroke-width="2" stroke-dasharray="8 6" 
        filter="url(#handDrawn)"
        opacity="0.85"
      />

      <text x="45" y="55" fill="#60a5fa" font-family="'Caveat', cursive, sans-serif" font-size="22" font-weight="700">
        ✦ Closed System Boundary: Systemic Sum S = $1,500.00 (Invariant: dS/dt ≡ 0) ✦
      </text>

      <!-- ================= ACCOUNT A (SOURCE) ================= -->
      <g transform="translate(50, 90)">
        <rect 
          x="0" y="0" width="220" height="210" rx="14" 
          fill="#0d1321" stroke="#3b82f6" stroke-width="2.5" 
          filter="url(#handDrawn)" 
        />
        <text x="20" y="35" fill="#f8fafc" font-family="'Inter', sans-serif" font-size="16" font-weight="800">
          Account A (Source)
        </text>
        <text x="20" y="58" fill="#94a3b8" font-family="'Fira Code', monospace" font-size="12">
          Node: microservice-db-1
        </text>

        <!-- Account A balance breakdown -->
        <rect x="15" y="75" width="190" height="42" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="1" />
        <text x="25" y="94" fill="#94a3b8" font-family="'Inter', sans-serif" font-size="11">Initial Balance (t₀)</text>
        <text x="25" y="110" fill="#60a5fa" font-family="'Fira Code', monospace" font-size="14" font-weight="700">$1,000.00</text>

        <path d="M 110 125 L 110 140" stroke="#f59e0b" stroke-width="2" marker-end="url(#arrowAmber)" />

        <rect x="15" y="145" width="190" height="48" rx="8" fill="#1e1e2e" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="4 3" />
        <text x="25" y="163" fill="#f87171" font-family="'Inter', sans-serif" font-size="11">Step 1: Debit -$200.00</text>
        <text x="25" y="182" fill="#34d399" font-family="'Fira Code', monospace" font-size="13" font-weight="700">New Bal: $800.00</text>
      </g>

      <!-- ================= STEP 1 TRANSFER ARROW ================= -->
      <path 
        d="M 275 220 C 315 220, 335 220, 365 220" 
        fill="none" stroke="#f59e0b" stroke-width="3" stroke-linecap="round" 
        marker-end="url(#arrowAmber)"
        filter="url(#handDrawn)"
      />
      <text x="290" y="205" fill="#f59e0b" font-family="'Caveat', cursive, sans-serif" font-size="18" font-weight="700">
        Step 1: -$200 Debit
      </text>

      <!-- ================= CENTER ESCROW BUFFER ================= -->
      <g transform="translate(370, 110)">
        <rect 
          x="0" y="0" width="220" height="230" rx="16" 
          fill="url(#escrowGrad)" stroke="#f59e0b" stroke-width="2.5" stroke-dasharray="6 4"
          filter="url(#handDrawn)" 
        />
        <text x="20" y="32" fill="#fbbf24" font-family="'Inter', sans-serif" font-size="15" font-weight="800">
          In-Flight Escrow Tunnel
        </text>
        <text x="20" y="52" fill="#94a3b8" font-family="'Fira Code', monospace" font-size="11">
          State: DEBITED (In-Flight)
        </text>

        <!-- Escrow details -->
        <rect x="15" y="65" width="190" height="52" rx="8" fill="#181e2e" stroke="#f59e0b" stroke-width="1.5" />
        <text x="25" y="85" fill="#fcd34d" font-family="'Inter', sans-serif" font-size="11">Quarantined Balance</text>
        <text x="25" y="106" fill="#f59e0b" font-family="'Fira Code', monospace" font-size="18" font-weight="900">+$200.00</text>

        <!-- Discrete Invariant Note inside Escrow -->
        <rect x="15" y="128" width="190" height="85" rx="8" fill="#090d16" stroke="#3b82f6" stroke-width="1" />
        <text x="22" y="148" fill="#93c5fd" font-family="'Caveat', cursive, sans-serif" font-size="16" font-weight="700">
          Invariant Verification:
        </text>
        <text x="22" y="170" fill="#cbd5e1" font-family="'Fira Code', monospace" font-size="11">
          A: $800 + Escrow: $200
        </text>
        <text x="22" y="188" fill="#cbd5e1" font-family="'Fira Code', monospace" font-size="11">
          + B: $500 = $1,500 ≡ S
        </text>
        <text x="22" y="204" fill="#34d399" font-family="'Inter', sans-serif" font-size="10" font-weight="700">
          ✓ Zero Cents Leaked!
        </text>
      </g>

      <!-- ================= BRANCH 1: HAPPY PATH TO ACCOUNT B ================= -->
      <path 
        d="M 595 180 C 635 150, 650 150, 685 160" 
        fill="none" stroke="#10b981" stroke-width="3" stroke-linecap="round" 
        marker-end="url(#arrowGreen)"
        filter="url(#handDrawn)"
      />
      <text x="595" y="140" fill="#34d399" font-family="'Caveat', cursive, sans-serif" font-size="18" font-weight="700">
        Path 1: Remote Credit (200 OK)
      </text>

      <!-- ================= ACCOUNT B (TARGET) ================= -->
      <g transform="translate(690, 90)">
        <rect 
          x="0" y="0" width="220" height="210" rx="14" 
          fill="#0d1321" stroke="#10b981" stroke-width="2.5" 
          filter="url(#handDrawn)" 
        />
        <text x="20" y="35" fill="#f8fafc" font-family="'Inter', sans-serif" font-size="16" font-weight="800">
          Account B (Target)
        </text>
        <text x="20" y="58" fill="#94a3b8" font-family="'Fira Code', monospace" font-size="12">
          Node: microservice-db-2
        </text>

        <!-- Account B balance breakdown -->
        <rect x="15" y="75" width="190" height="42" rx="8" fill="#1e293b" stroke="#10b981" stroke-width="1" />
        <text x="25" y="94" fill="#94a3b8" font-family="'Inter', sans-serif" font-size="11">Initial Balance (t₀)</text>
        <text x="25" y="110" fill="#34d399" font-family="'Fira Code', monospace" font-size="14" font-weight="700">$500.00</text>

        <path d="M 110 125 L 110 140" stroke="#10b981" stroke-width="2" marker-end="url(#arrowGreen)" />

        <rect x="15" y="145" width="190" height="48" rx="8" fill="#064e3b" stroke="#34d399" stroke-width="1.5" />
        <text x="25" y="163" fill="#a7f3d0" font-family="'Inter', sans-serif" font-size="11">Step 2: Credit +$200.00</text>
        <text x="25" y="182" fill="#6ee7b7" font-family="'Fira Code', monospace" font-size="13" font-weight="800">Final Bal: $700.00</text>
      </g>

      <!-- ================= BRANCH 2: COMPENSATING ROLLBACK PATH ================= -->
      <!-- Timeout cross -->
      <g transform="translate(650, 300)">
        <circle cx="15" cy="15" r="16" fill="#450a0a" stroke="#ef4444" stroke-width="2" />
        <text x="9" y="21" fill="#fca5a5" font-family="'Inter', sans-serif" font-size="16" font-weight="900">✕</text>
        <text x="38" y="20" fill="#f87171" font-family="'Caveat', cursive, sans-serif" font-size="16" font-weight="700">
          504 Gateway Timeout!
        </text>
      </g>

      <!-- Compensating Return Arrow from Escrow back to Account A -->
      <path 
        d="M 410 345 C 320 400, 220 380, 160 305" 
        fill="none" stroke="#ef4444" stroke-width="2.5" stroke-dasharray="7 5" stroke-linecap="round" 
        marker-end="url(#arrowRed)"
        filter="url(#handDrawn)"
      />
      <text x="200" y="390" fill="#f87171" font-family="'Caveat', cursive, sans-serif" font-size="18" font-weight="700">
        Path 2: Compensating Rollback (Refund Credit +$200.00 back to A)
      </text>

      <!-- ================= BOTTOM DOUBLE-ENTRY JOURNAL ================= -->
      <g transform="translate(50, 420)">
        <rect 
          x="0" y="0" width="860" height="75" rx="10" 
          fill="#0a0f1d" stroke="#3b82f6" stroke-width="1.5" 
          filter="url(#handDrawn)" 
        />
        <text x="20" y="24" fill="#93c5fd" font-family="'Inter', sans-serif" font-size="12" font-weight="700" letter-spacing="0.05em">
          IMMUTABLE DOUBLE-ENTRY JOURNAL (APPEND-ONLY LEDGER)
        </text>
        
        <!-- Entry 1 -->
        <rect x="20" y="34" width="220" height="30" rx="6" fill="#1e293b" stroke="#3b82f6" stroke-width="1" />
        <text x="30" y="53" fill="#cbd5e1" font-family="'Fira Code', monospace" font-size="11">
          #1 DEBIT Acc-A: $200.00
        </text>

        <!-- Entry 2: Happy Path -->
        <rect x="260" y="34" width="220" height="30" rx="6" fill="#064e3b" stroke="#10b981" stroke-width="1" />
        <text x="270" y="53" fill="#a7f3d0" font-family="'Fira Code', monospace" font-size="11">
          #2 CREDIT Acc-B: $200.00
        </text>

        <text x="495" y="54" fill="#94a3b8" font-family="'Inter', sans-serif" font-size="12">OR</text>

        <!-- Entry 2: Rollback Path -->
        <rect x="530" y="34" width="290" height="30" rx="6" fill="#450a0a" stroke="#ef4444" stroke-width="1" />
        <text x="540" y="53" fill="#fca5a5" font-family="'Fira Code', monospace" font-size="11">
          #2c CREDIT Acc-A (COMPENSATE): $200.00
        </text>
      </g>
    </svg>
  </div>

  <div class="diagram-caption">
    <span class="caption-icon">💡</span>
    <span>
      <strong>Mental Model Takeaway:</strong> In a distributed Saga, money is never "in limbo". When debited, it enters the formal in-flight escrow state. Whether the remote credit succeeds or rolls back, the balance sum across accounts and escrow is strictly invariant (A + B + Escrow ≡ S) at every single step.
    </span>
  </div>
</div>

<style>
  .excalidraw-container {
    margin: 2.5rem 0;
    border-radius: 1.15rem;
    background: rgba(13, 19, 33, 0.7);
    border: 1.5px solid rgba(59, 130, 246, 0.3);
    overflow: hidden;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
  }

  :root[data-theme='light'] .excalidraw-container {
    background: rgba(255, 255, 255, 0.95);
    border-color: rgba(203, 213, 225, 0.9);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .diagram-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.4rem;
    background: rgba(15, 23, 42, 0.75);
    border-bottom: 1px solid rgba(59, 130, 246, 0.2);
  }

  :root[data-theme='light'] .diagram-toolbar {
    background: #f8fafc;
    border-color: #e2e8f0;
  }

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toolbar-icon {
    color: #f59e0b;
    font-size: 1.1rem;
  }

  .toolbar-title {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #93c5fd;
    text-transform: uppercase;
  }

  :root[data-theme='light'] .toolbar-title {
    color: #1e3a8a;
  }

  .toolbar-tags {
    display: flex;
    gap: 0.4rem;
  }

  .tool-tag {
    font-size: 0.72rem;
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.3);
    font-weight: 600;
  }

  .tool-tag.tag-gold {
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
    border-color: rgba(245, 158, 11, 0.35);
  }

  .diagram-canvas-wrap {
    padding: 1.25rem 1rem 0.5rem;
    display: flex;
    justify-content: center;
    background: radial-gradient(circle at 50% 50%, rgba(30, 58, 138, 0.1) 0%, transparent 80%);
  }

  .excalidraw-svg {
    width: 100%;
    max-width: 960px;
    height: auto;
    display: block;
  }

  .diagram-caption {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.95rem 1.4rem;
    background: rgba(15, 23, 42, 0.6);
    border-top: 1px solid rgba(59, 130, 246, 0.15);
    font-size: 0.88rem;
    line-height: 1.5;
    color: #cbd5e1;
  }

  :root[data-theme='light'] .diagram-caption {
    background: #f8fafc;
    border-color: #e2e8f0;
    color: #334155;
  }

  .caption-icon {
    font-size: 1.1rem;
    line-height: 1;
    margin-top: 0.1rem;
  }
</style>
