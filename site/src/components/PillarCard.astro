---
import BorderBeam from './BorderBeam.astro';

interface Props {
  number: string;
  title: string;
  domain: string;
  formula?: string;
  description?: string;
  beamColorFrom?: string;
  beamColorTo?: string;
  beamDuration?: number;
  icon?: string;
  class?: string;
}

const {
  number,
  title,
  domain,
  formula = "",
  description = "",
  beamColorFrom = "#3b82f6",
  beamColorTo = "#60a5fa",
  beamDuration = 7,
  icon = "✦",
  class: className = "",
} = Astro.props;
---

<div class={`pillar-card-wrap ${className}`}>
  <!-- Magic UI Traveling Border Light Beam (Razor-thin 1.5px) -->
  <BorderBeam 
    duration={beamDuration} 
    borderWidth={1.5} 
    colorFrom={beamColorFrom} 
    colorTo={beamColorTo} 
  />

  <div class="pillar-card-inner">
    <!-- Ambient card gradient aura -->
    <div class="pillar-card-aura" style={`--aura-color: ${beamColorFrom};`}></div>

    <!-- Header with index and icon -->
    <div class="pillar-header">
      <div class="pillar-index-pill" style={`--accent-color: ${beamColorFrom};`}>
        <span class="pillar-number">{number}</span>
      </div>
      <div class="pillar-icon-badge" style={`--accent-color: ${beamColorFrom};`}>
        <span>{icon}</span>
      </div>
    </div>

    <!-- Card Title -->
    <h3 class="pillar-title">{title}</h3>

    <!-- Systems Domain Pill -->
    <div class="pillar-domain">
      <span class="domain-label">Production Domain:</span>
      <span class="domain-value">{domain}</span>
    </div>

    <!-- KaTeX Formula Container -->
    <div class="pillar-formula-box">
      <slot name="formula">
        {formula && <div set:html={formula} />}
      </slot>
    </div>

    <!-- Explanation -->
    <div class="pillar-desc">
      <slot>
        {description}
      </slot>
    </div>
  </div>
</div>

<style>
  .pillar-card-wrap {
    position: relative;
    border-radius: 1rem;
    background: rgba(13, 19, 33, 0.9);
    border: 1px solid rgba(59, 130, 246, 0.2);
    overflow: hidden;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
                box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.35s ease;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
  }

  .pillar-card-wrap:hover {
    transform: translateY(-6px);
    border-color: rgba(96, 165, 250, 0.45);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), 0 0 30px rgba(59, 130, 246, 0.2);
  }

  :root[data-theme='light'] .pillar-card-wrap {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(203, 213, 225, 0.8);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
  }

  :root[data-theme='light'] .pillar-card-wrap:hover {
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12), 0 0 20px rgba(59, 130, 246, 0.15);
  }

  .pillar-card-inner {
    position: relative;
    z-index: 2;
    border-radius: inherit;
    background: rgba(13, 19, 33, 0.85);
    padding: 1.75rem 1.6rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  :root[data-theme='light'] .pillar-card-inner {
    background: rgba(255, 255, 255, 0.9);
  }

  .pillar-card-aura {
    position: absolute;
    top: -50px;
    right: -50px;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--aura-color, #3b82f6) 0%, transparent 70%);
    opacity: 0.15;
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .pillar-card-wrap:hover .pillar-card-aura {
    opacity: 0.3;
    transform: scale(1.3);
  }

  .pillar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .pillar-index-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid var(--accent-color, #3b82f6);
    box-shadow: 0 0 12px rgba(59, 130, 246, 0.2);
  }

  .pillar-number {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--accent-color, #60a5fa);
    letter-spacing: 0.05em;
  }

  .pillar-icon-badge {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    color: var(--accent-color, #60a5fa);
  }

  .pillar-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 0.75rem 0;
    color: #f8fafc;
    letter-spacing: -0.015em;
  }

  :root[data-theme='light'] .pillar-title {
    color: #0f172a;
  }

  .pillar-domain {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 1.2rem;
  }

  :root[data-theme='light'] .pillar-domain {
    background: #f1f5f9;
    border-color: #e2e8f0;
  }

  .domain-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    color: #94a3b8;
  }

  .domain-value {
    font-size: 0.86rem;
    font-weight: 600;
    color: #93c5fd;
    font-family: var(--sl-font-mono, monospace);
  }

  :root[data-theme='light'] .domain-value {
    color: #2563eb;
  }

  .pillar-formula-box {
    background: rgba(10, 15, 28, 0.75);
    border: 1px dashed rgba(59, 130, 246, 0.35);
    border-radius: 0.65rem;
    padding: 0.85rem 1rem;
    margin-bottom: 1.1rem;
    text-align: center;
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.3);
    overflow-x: auto;
  }

  :root[data-theme='light'] .pillar-formula-box {
    background: #f8fafc;
    border-color: #cbd5e1;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.04);
  }

  .pillar-desc {
    font-size: 0.9rem;
    line-height: 1.55;
    color: #cbd5e1;
    margin: 0;
    flex-grow: 1;
  }

  :root[data-theme='light'] .pillar-desc {
    color: #475569;
  }
</style>
