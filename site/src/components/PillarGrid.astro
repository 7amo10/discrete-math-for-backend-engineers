---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class={`pillar-grid ${className}`}>
  <slot />
</div>

<style>
  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }

  @media (min-width: 1024px) {
    .pillar-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
