---
interface Props {
  angle?: number;
  cellSize?: number;
  opacity?: number;
  lightLineColor?: string;
  darkLineColor?: string;
  class?: string;
}

const {
  angle = 65,
  cellSize = 55,
  opacity = 0.65,
  lightLineColor = "rgba(59, 130, 246, 0.25)",
  darkLineColor = "rgba(59, 130, 246, 0.35)",
  class: className = "",
} = Astro.props;
---

<!-- Magic UI Full-Screen Animated Retro Grid -->
<div 
  class={`retro-grid-container ${className}`} 
  style={`--grid-angle: ${angle}deg; --grid-cell-size: ${cellSize}px; --grid-opacity: ${opacity};`}
  aria-hidden="true"
>
  <div class="retro-grid-plane">
    <div class="retro-grid-lines"></div>
  </div>
  <!-- Soft vignette aura to blend with dark mode -->
  <div class="retro-grid-vignette"></div>
</div>

<style>
  .retro-grid-container {
    pointer-events: none;
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    perspective: 260px;
    z-index: 0;
  }

  .retro-grid-plane {
    position: absolute;
    inset: 0;
    transform: rotateX(var(--grid-angle));
    transform-origin: 50% 10%;
  }

  .retro-grid-lines {
    animation: retro-grid-scroll 14s linear infinite;
    background-repeat: repeat;
    background-size: var(--grid-cell-size) var(--grid-cell-size);
    height: 350vh;
    margin-left: -50%;
    transform-origin: 100% 0 0;
    width: 200%;
    opacity: var(--grid-opacity);
    background-image: 
      linear-gradient(to right, rgba(59, 130, 246, 0.35) 1.5px, transparent 0),
      linear-gradient(to bottom, rgba(59, 130, 246, 0.35) 1.5px, transparent 0);
  }

  :root[data-theme='light'] .retro-grid-lines {
    background-image: 
      linear-gradient(to right, rgba(37, 99, 235, 0.22) 1.5px, transparent 0),
      linear-gradient(to bottom, rgba(37, 99, 235, 0.22) 1.5px, transparent 0);
  }

  .retro-grid-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 40%, transparent 20%, rgba(7, 11, 20, 0.65) 90%);
    pointer-events: none;
  }

  :root[data-theme='light'] .retro-grid-vignette {
    background: radial-gradient(circle at 50% 40%, transparent 20%, rgba(248, 250, 252, 0.6) 90%);
  }

  @keyframes retro-grid-scroll {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(var(--grid-cell-size));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .retro-grid-lines {
      animation: none;
    }
  }
</style>
