---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class={`excalidraw-container ${className}`}>
  <div class="diagram-toolbar">
    <div class="toolbar-left">
      <span class="toolbar-icon">✎</span>
      <span class="toolbar-title">WAIT-FOR GRAPH (WFG) &amp; TARJAN DEADLOCK RESOLUTION</span>
    </div>
    <div class="toolbar-tags">
      <span class="tool-tag tag-cyan">Directed Cycles O(V+E)</span>
      <span class="tool-tag tag-gold">Min-Cost Victim Selection</span>
    </div>
  </div>

  <div class="diagram-canvas-wrap">
    <svg 
      viewBox="0 0 960 560" 
      class="excalidraw-svg" 
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="Wait-For Graph and Tarjan Deadlock Resolution mental model blueprint"
    >
      <defs>
        <!-- Gradients -->
        <linearGradient id="cardDarkGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#0f172a" stop-opacity="0.95" />
          <stop offset="100%" stop-color="#090d16" stop-opacity="0.95" />
        </linearGradient>
        <radialGradient id="deadlockGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#ef4444" stop-opacity="0.18" />
          <stop offset="100%" stop-color="#ef4444" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="safeGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#10b981" stop-opacity="0.15" />
          <stop offset="100%" stop-color="#10b981" stop-opacity="0" />
        </radialGradient>

        <!-- Arrow Markers -->
        <marker id="arrowRedWfg" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 10 5 L 0 9 z" fill="#ef4444" />
        </marker>
        <marker id="arrowCyanWfg" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 10 5 L 0 9 z" fill="#06b6d4" />
        </marker>
        <marker id="arrowGreenWfg" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 10 5 L 0 9 z" fill="#10b981" />
        </marker>
        <marker id="arrowGoldWfg" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 10 5 L 0 9 z" fill="#f59e0b" />
        </marker>
      </defs>

      <!-- Background Grid -->
      <rect width="960" height="560" fill="#070b14" rx="14" />
      <g stroke="#3b82f6" stroke-width="0.5" stroke-opacity="0.08">
        <line x1="40" y1="0" x2="40" y2="560" />
        <line x1="160" y1="0" x2="160" y2="560" />
        <line x1="280" y1="0" x2="280" y2="560" />
        <line x1="400" y1="0" x2="400" y2="560" />
        <line x1="520" y1="0" x2="520" y2="560" />
        <line x1="640" y1="0" x2="640" y2="560" />
        <line x1="760" y1="0" x2="760" y2="560" />
        <line x1="880" y1="0" x2="880" y2="560" />
        <line x1="0" y1="60" x2="960" y2="60" />
        <line x1="0" y1="160" x2="960" y2="160" />
        <line x1="0" y1="260" x2="960" y2="260" />
        <line x1="0" y1="360" x2="960" y2="360" />
        <line x1="0" y1="460" x2="960" y2="460" />
      </g>

      <!-- SECTION 1: WAIT-FOR GRAPH CANVAS (LEFT) -->
      <g transform="translate(40, 30)">
        <!-- Area Outline -->
        <rect x="0" y="0" width="460" height="495" rx="10" fill="url(#cardDarkGrad)" stroke="#3b82f6" stroke-width="1.2" stroke-opacity="0.3" />
        <rect x="0" y="0" width="460" height="38" rx="10" fill="#0f172a" fill-opacity="0.8" />
        <text x="20" y="24" fill="#93c5fd" font-family="'Fira Code', monospace" font-size="12" font-weight="700" letter-spacing="0.06em">TOPOLOGY 1: RELATIONAL WAIT-FOR GRAPH (WFG)</text>

        <!-- Deadlock Cycle Zone Glow -->
        <circle cx="160" cy="180" r="115" fill="url(#deadlockGlow)" />
        <rect x="40" y="65" width="240" height="230" rx="8" fill="none" stroke="#ef4444" stroke-width="1.2" stroke-dasharray="4 4" stroke-opacity="0.5" />
        <rect x="52" y="55" width="130" height="18" rx="4" fill="#1e1b2e" />
        <text x="58" y="68" fill="#f87171" font-family="'Fira Code', monospace" font-size="10" font-weight="700">DETECTED DEADLOCK CYCLE</text>

        <!-- Node T1 (Batch Writer) -->
        <g transform="translate(70, 110)">
          <rect x="0" y="0" width="180" height="52" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="1.5" />
          <circle cx="20" cy="26" r="10" fill="#3b82f6" fill-opacity="0.2" stroke="#3b82f6" stroke-width="1.5" />
          <text x="16" y="30" fill="#93c5fd" font-family="'Inter', sans-serif" font-size="11" font-weight="800">T1</text>
          <text x="40" y="22" fill="#f8fafc" font-family="'Inter', sans-serif" font-size="12" font-weight="700">tx-batch-writer</text>
          <text x="40" y="40" fill="#94a3b8" font-family="'Fira Code', monospace" font-size="10">Holds: R1 | Waits: R2</text>
        </g>

        <!-- Node T2 (Quick Update) -->
        <g transform="translate(70, 215)">
          <rect x="0" y="0" width="180" height="52" rx="8" fill="#1e293b" stroke="#ef4444" stroke-width="1.5" />
          <circle cx="20" cy="26" r="10" fill="#ef4444" fill-opacity="0.2" stroke="#ef4444" stroke-width="1.5" />
          <text x="16" y="30" fill="#fca5a5" font-family="'Inter', sans-serif" font-size="11" font-weight="800">T2</text>
          <text x="40" y="22" fill="#f8fafc" font-family="'Inter', sans-serif" font-size="12" font-weight="700">tx-quick-update</text>
          <text x="40" y="40" fill="#f87171" font-family="'Fira Code', monospace" font-size="10">Holds: R2 | Waits: R1</text>
        </g>

        <!-- Directed Edges for T1 <-> T2 -->
        <!-- Edge T1 -> T2 (Waiting for R2) -->
        <path d="M 230 162 L 230 215" stroke="#ef4444" stroke-width="2.5" fill="none" marker-end="url(#arrowRedWfg)" />
        <rect x="235" y="180" width="75" height="18" rx="3" fill="#1e131d" />
        <text x="240" y="193" fill="#fca5a5" font-family="'Fira Code', monospace" font-size="9">Waits for R2</text>

        <!-- Edge T2 -> T1 (Waiting for R1) -->
        <path d="M 90 215 L 90 162" stroke="#ef4444" stroke-width="2.5" fill="none" marker-end="url(#arrowRedWfg)" />
        <rect x="15" y="180" width="70" height="18" rx="3" fill="#1e131d" />
        <text x="20" y="193" fill="#fca5a5" font-family="'Fira Code', monospace" font-size="9">Waits for R1</text>

        <!-- Node T3 (Blocked downstream) -->
        <g transform="translate(70, 325)">
          <rect x="0" y="0" width="180" height="46" rx="8" fill="#151e2e" stroke="#64748b" stroke-width="1.2" />
          <circle cx="20" cy="23" r="10" fill="#64748b" fill-opacity="0.2" stroke="#64748b" stroke-width="1.2" />
          <text x="16" y="27" fill="#cbd5e1" font-family="'Inter', sans-serif" font-size="11" font-weight="800">T3</text>
          <text x="40" y="20" fill="#e2e8f0" font-family="'Inter', sans-serif" font-size="11" font-weight="600">tx-downstream</text>
          <text x="40" y="36" fill="#94a3b8" font-family="'Fira Code', monospace" font-size="9.5">Waits on T1 (Blocked)</text>
        </g>
        <path d="M 160 325 L 160 267" stroke="#64748b" stroke-width="1.5" stroke-dasharray="3 3" fill="none" marker-end="url(#arrowCyanWfg)" />

        <!-- Node T4 -> T5 (Acyclic DAG Safe Branch) -->
        <g transform="translate(300, 110)">
          <rect x="0" y="0" width="135" height="45" rx="6" fill="#064e3b" fill-opacity="0.25" stroke="#10b981" stroke-width="1.2" />
          <text x="12" y="18" fill="#6ee7b7" font-family="'Inter', sans-serif" font-size="11" font-weight="700">T4 (Read Row 8)</text>
          <text x="12" y="34" fill="#34d399" font-family="'Fira Code', monospace" font-size="9">Status: EXECUTING</text>
        </g>
        <g transform="translate(300, 215)">
          <rect x="0" y="0" width="135" height="45" rx="6" fill="#064e3b" fill-opacity="0.25" stroke="#10b981" stroke-width="1.2" />
          <text x="12" y="18" fill="#6ee7b7" font-family="'Inter', sans-serif" font-size="11" font-weight="700">T5 (Read Row 9)</text>
          <text x="12" y="34" fill="#34d399" font-family="'Fira Code', monospace" font-size="9">Status: EXECUTING</text>
        </g>
        <path d="M 367 155 L 367 215" stroke="#10b981" stroke-width="1.5" fill="none" marker-end="url(#arrowGreenWfg)" />
        <text x="375" y="188" fill="#6ee7b7" font-family="'Fira Code', monospace" font-size="9">DAG Edge</text>

        <!-- Summary Banner Bottom of Left Box -->
        <rect x="15" y="420" width="430" height="60" rx="6" fill="#0d1527" stroke="#3b82f6" stroke-width="1" stroke-opacity="0.3" />
        <text x="28" y="442" fill="#93c5fd" font-family="'Inter', sans-serif" font-size="11" font-weight="700">Graph Theory Theorem (MIT 6.042J Theorem 5.4.1):</text>
        <text x="28" y="462" fill="#cbd5e1" font-family="'Newsreader', Georgia, serif" font-size="13" font-style="italic">
          A transactional deadlock exists ⟺ the Wait-For Graph G contains a directed cycle C.
        </text>
      </g>

      <!-- SECTION 2: TARJAN SCC & VICTIM SELECTION (RIGHT) -->
      <g transform="translate(520, 30)">
        <rect x="0" y="0" width="400" height="495" rx="10" fill="url(#cardDarkGrad)" stroke="#3b82f6" stroke-width="1.2" stroke-opacity="0.3" />
        <rect x="0" y="0" width="400" height="38" rx="10" fill="#0f172a" fill-opacity="0.8" />
        <text x="20" y="24" fill="#93c5fd" font-family="'Fira Code', monospace" font-size="12" font-weight="700" letter-spacing="0.06em">ENGINE 2: TARJAN O(V+E) &amp; VICTIM HEURISTIC</text>

        <!-- Step 1 Card: Tarjan SCC Traversal -->
        <g transform="translate(15, 55)">
          <rect x="0" y="0" width="370" height="120" rx="8" fill="#141d2f" stroke="#06b6d4" stroke-width="1" stroke-opacity="0.4" />
          <rect x="12" y="10" width="130" height="20" rx="4" fill="#083344" />
          <text x="18" y="24" fill="#67e8f9" font-family="'Fira Code', monospace" font-size="10" font-weight="700">TARJAN DFS STATE</text>
          
          <text x="14" y="48" fill="#f8fafc" font-family="'Fira Code', monospace" font-size="10.5">
            dfn[T1]=1, low[T1]=1  <tspan fill="#64748b">/* Root of DFS tree */</tspan>
          </text>
          <text x="14" y="68" fill="#f8fafc" font-family="'Fira Code', monospace" font-size="10.5">
            dfn[T2]=2, low[T2]=1  <tspan fill="#f59e0b">/* Back-edge to T1! */</tspan>
          </text>
          <path d="M 14 80 L 356 80" stroke="#334155" stroke-width="0.8" />
          <text x="14" y="98" fill="#38bdf8" font-family="'Inter', sans-serif" font-size="11" font-weight="700">
            Root Condition: <tspan fill="#f8fafc">low[T1] == dfn[T1]</tspan>
          </text>
          <text x="14" y="112" fill="#94a3b8" font-family="'Inter', sans-serif" font-size="10">
            Pops &#123;T1, T2&#125; from stack &rarr; Strongly Connected Component!
          </text>
        </g>

        <!-- Step 2 Card: Cost-Weighted Victim Selection -->
        <g transform="translate(15, 190)">
          <rect x="0" y="0" width="370" height="165" rx="8" fill="#141d2f" stroke="#f59e0b" stroke-width="1" stroke-opacity="0.4" />
          <rect x="12" y="10" width="175" height="20" rx="4" fill="#451a03" />
          <text x="18" y="24" fill="#fcd34d" font-family="'Fira Code', monospace" font-size="10" font-weight="700">MIN-COST VICTIM DECISION</text>

          <text x="14" y="48" fill="#94a3b8" font-family="'Inter', sans-serif" font-size="10.5">
            Cost Formula: <tspan fill="#fcd34d" font-family="'Fira Code', monospace">Cost(T) = (0.1·ms) + (1.0·rows) + (10·pri)</tspan>
          </text>

          <!-- T1 Cost Evaluation -->
          <g transform="translate(14, 60)">
            <rect x="0" y="0" width="342" height="38" rx="4" fill="#0f172a" stroke="#3b82f6" stroke-width="0.8" />
            <text x="10" y="16" fill="#93c5fd" font-family="'Fira Code', monospace" font-size="10" font-weight="700">T1 (tx-batch-writer):</text>
            <text x="10" y="30" fill="#e2e8f0" font-family="'Fira Code', monospace" font-size="9.5">
              (0.1·4200) + (1.0·5000) + (10·5) = <tspan fill="#34d399" font-weight="700">5,470 (PRESERVED)</tspan>
            </text>
          </g>

          <!-- T2 Cost Evaluation -->
          <g transform="translate(14, 106)">
            <rect x="0" y="0" width="342" height="38" rx="4" fill="#2d1519" stroke="#ef4444" stroke-width="1.2" />
            <text x="10" y="16" fill="#fca5a5" font-family="'Fira Code', monospace" font-size="10" font-weight="700">T2 (tx-quick-update):</text>
            <text x="10" y="30" fill="#fca5a5" font-family="'Fira Code', monospace" font-size="9.5">
              (0.1·5) + (1.0·1) + (10·1) = <tspan fill="#ef4444" font-weight="800">11.5 (SELECTED VICTIM)</tspan>
            </text>
          </g>
        </g>

        <!-- Step 3 Card: Resolution Impact Metric -->
        <g transform="translate(15, 370)">
          <rect x="0" y="0" width="370" height="110" rx="8" fill="#091424" stroke="#10b981" stroke-width="1" stroke-opacity="0.4" />
          <rect x="12" y="10" width="160" height="20" rx="4" fill="#064e3b" fill-opacity="0.6" />
          <text x="18" y="24" fill="#6ee7b7" font-family="'Fira Code', monospace" font-size="10" font-weight="700">PRODUCTION IMPACT</text>

          <text x="14" y="50" fill="#f8fafc" font-family="'Inter', sans-serif" font-size="11">
            • <tspan fill="#6ee7b7" font-weight="700">Resolution Latency:</tspan> &lt; 0.5ms (vs. 50s timeout)
          </text>
          <text x="14" y="70" fill="#f8fafc" font-family="'Inter', sans-serif" font-size="11">
            • <tspan fill="#6ee7b7" font-weight="700">Work Discarded:</tspan> Only 1 row (99.98% preserved)
          </text>
          <text x="14" y="90" fill="#f8fafc" font-family="'Inter', sans-serif" font-size="11">
            • <tspan fill="#6ee7b7" font-weight="700">PostgreSQL Code:</tspan> Emits <tspan fill="#93c5fd" font-family="'Fira Code', monospace">40P01 (deadlock_detected)</tspan>
          </text>
        </g>
      </g>
    </svg>
  </div>
</div>

<style>
  .excalidraw-container {
    margin: 2.5rem 0;
    border-radius: 1rem;
    background: #070b14;
    border: 1.5px solid rgba(59, 130, 246, 0.3);
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
  }

  :root[data-theme='light'] .excalidraw-container {
    background: #f8fafc;
    border-color: rgba(203, 213, 225, 0.9);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
  }

  .diagram-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.25rem;
    background: rgba(15, 23, 42, 0.9);
    border-bottom: 1px solid rgba(59, 130, 246, 0.2);
    font-family: var(--sl-font-mono, monospace);
  }

  :root[data-theme='light'] .diagram-toolbar {
    background: #f1f5f9;
    border-color: #cbd5e1;
  }

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toolbar-icon {
    color: #60a5fa;
    font-size: 1rem;
  }

  .toolbar-title {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #93c5fd;
  }

  :root[data-theme='light'] .toolbar-title {
    color: #1e293b;
  }

  .toolbar-tags {
    display: flex;
    gap: 0.5rem;
  }

  .tool-tag {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }

  .tag-cyan {
    background: rgba(6, 182, 212, 0.15);
    color: #22d3ee;
    border: 1px solid rgba(6, 182, 212, 0.35);
  }

  .tag-gold {
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.35);
  }

  .diagram-canvas-wrap {
    padding: 1.25rem;
    background: #070b14;
    display: flex;
    justify-content: center;
  }

  :root[data-theme='light'] .diagram-canvas-wrap {
    background: #ffffff;
  }

  .excalidraw-svg {
    width: 100%;
    height: auto;
    max-width: 960px;
    display: block;
    border-radius: 8px;
  }
</style>
