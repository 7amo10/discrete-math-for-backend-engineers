---
interface Props {
  quantity?: number;
  color?: string;
  size?: number;
  opacity?: number;
  drift?: number;
  depth?: number;
  class?: string;
}

const {
  quantity = 250,
  color = "#3b82f6",
  size = 4,
  opacity = 0.45,
  drift = 0.5,
  depth = 0.6,
  class: className = "",
} = Astro.props;
---

<div class={`floating-particles-container ${className}`}>
  <canvas
    class="floating-particles-canvas"
    data-quantity={quantity}
    data-color={color}
    data-size={size}
    data-opacity={opacity}
    data-drift={drift}
    data-depth={depth}
    aria-hidden="true"
  ></canvas>
</div>

<style>
  .floating-particles-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .floating-particles-canvas {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  function initParticles() {
    const canvases = document.querySelectorAll<HTMLCanvasElement>('.floating-particles-canvas');
    
    canvases.forEach((canvas) => {
      if ((canvas as any)._particlesInitialized) return;
      (canvas as any)._particlesInitialized = true;

      const ctx = canvas.getContext('2d', { alpha: true });
      if (!ctx) return;

      const quantity = Number(canvas.dataset.quantity || 250);
      const colorHex = canvas.dataset.color || '#3b82f6';
      const baseSize = Number(canvas.dataset.size || 4);
      const baseOpacity = Number(canvas.dataset.opacity || 0.4);
      const drift = Number(canvas.dataset.drift || 0.5);
      const depth = Number(canvas.dataset.depth || 0.6);

      const SPREAD_FACTOR = 1.3;
      const MAX_DPR = 2;

      function hexToRgba(hex: string, alpha: number) {
        const clean = hex.replace('#', '').trim();
        const full = clean.length === 3 ? clean.split('').map(c => c + c).join('') : clean;
        const n = parseInt(full, 16);
        if (isNaN(n)) return `rgba(59, 130, 246, ${alpha})`;
        return `rgba(${(n >> 16) & 0xff}, ${(n >> 8) & 0xff}, ${n & 0xff}, ${alpha})`;
      }

      function deriveProjection(d: number) {
        const t = Math.max(0, Math.min(1, d));
        const fov = 800 - t * 600;
        const perspectiveDistance = 100 + t * 700;
        const depthRange = t * Math.min(400, fov + perspectiveDistance - 1);
        return { fov, perspectiveDistance, depthRange };
      }

      const { fov, perspectiveDistance, depthRange } = deriveProjection(depth);

      interface Particle {
        angle: number;
        radius: number;
        y: number;
        size: number;
        angularSpeed: number;
        opacity: number;
        screenX: number;
        screenY: number;
        projectedScale: number;
      }

      let width = 0;
      let height = 0;
      let particles: Particle[] = [];
      let rafId: number | null = null;
      let paused = false;

      function spawnParticle(w: number, h: number): Particle {
        const sizeVariance = baseSize * 0.4;
        return {
          angle: Math.random() * Math.PI * 2,
          radius: Math.random() * Math.max(w, h) * SPREAD_FACTOR,
          y: (Math.random() - 0.5) * h * 2,
          size: Math.max(0.5, baseSize - sizeVariance + Math.random() * sizeVariance * 2),
          angularSpeed: 0.0012 + Math.random() * 0.001,
          opacity: Math.min(1, Math.max(0.1, baseOpacity - 0.15 + Math.random() * 0.3)),
          screenX: 0,
          screenY: 0,
          projectedScale: 1,
        };
      }

      function resize() {
        const rect = canvas.getBoundingClientRect();
        width = Math.max(1, Math.round(rect.width));
        height = Math.max(1, Math.round(rect.height));

        const dpr = Math.max(1, Math.min(window.devicePixelRatio || 1, MAX_DPR));
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const count = window.innerWidth < 768 ? Math.round(quantity * 0.35) : quantity;
        particles = Array.from({ length: count }, () => spawnParticle(width, height));
      }

      function draw() {
        if (paused) {
          rafId = requestAnimationFrame(draw);
          return;
        }

        ctx.clearRect(0, 0, width, height);

        const cx = width / 2;
        const cy = height / 2;

        for (const p of particles) {
          p.angle += p.angularSpeed;
          p.y -= drift;

          if (p.y < -height) {
            p.y = height;
            p.radius = Math.random() * Math.max(width, height) * SPREAD_FACTOR;
          } else if (p.y > height) {
            p.y = -height;
            p.radius = Math.random() * Math.max(width, height) * SPREAD_FACTOR;
          }

          const denom = Math.max(1, fov + perspectiveDistance + Math.sin(p.angle) * depthRange);
          const scale = fov / denom;

          p.screenX = cx + Math.cos(p.angle) * p.radius * scale;
          p.screenY = cy + p.y * scale;
          p.projectedScale = scale;
        }

        particles.sort((a, b) => a.projectedScale - b.projectedScale);

        for (const p of particles) {
          const r = Math.max(0.5, p.size * p.projectedScale);
          ctx.beginPath();
          ctx.fillStyle = hexToRgba(colorHex, p.opacity);
          ctx.arc(p.screenX, p.screenY, r, 0, Math.PI * 2);
          ctx.fill();
        }

        rafId = requestAnimationFrame(draw);
      }

      window.addEventListener('resize', resize);
      document.addEventListener('visibilitychange', () => {
        paused = document.hidden;
      });

      resize();
      rafId = requestAnimationFrame(draw);
    });
  }

  // Initialize on load and on view transitions
  initParticles();
  document.addEventListener('astro:page-load', initParticles);
</script>
